# Copy to .env (never commit .env).
# Brain: set ANTHROPIC_API_KEY to use Claude, or leave it out to use a local Ollama model.
# ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_URL=http://192.168.1.10:11434
OLLAMA_MODEL=qwen3:8b
TELEGRAM_BOT_TOKEN=123456:ABC...
# Your Telegram user ID (message @userinfobot to get it). Comma-separate for more than one.
TELEGRAM_ALLOWED_USER_IDS=123456789
TZ=America/New_York
# Optional
# ADA_MODEL=claude-opus-5-5
# ADA_EFFORT=medium
# ADA_APPROVAL_TIMEOUT=600
